{
  "version": "2.0.0",
  "tasks": [
    {"type": "npm", "script": "compile", "group": {"kind": "build", "isDefault": true}, "problemMatcher": "$tsc"},
    {"type": "npm", "script": "watch", "isBackground": true, "problemMatcher": {"owner": "typescript", "pattern": {"regexp": "^(.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4}, "background": {"activeOnStart": true, "beginsPattern": "build started", "endsPattern": "build finished"}}}
  ]
}
